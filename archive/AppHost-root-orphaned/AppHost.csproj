<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aspire 13.x AppHost projects need the AppHost SDK alongside the .NET SDK.
       The previous file pinned Aspire 9.0.0 (Nov 2024) and omitted it entirely. -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.4" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>pmcro-marketplace-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\PMCR.OrchestratorService\PMCR.OrchestratorService.csproj" />
  </ItemGroup>
</Project>
