{
  "template": "skill",
  "name": "example-skill",
  "version": "1.0.0",
  "description": "Scaffolds a new SKILL.md under plugins/<plugin_name>/skills/<skill_name>/.",
  "vars": {
    "plugin_name": { "type": "string", "required": true },
    "skill_name": { "type": "string", "required": true },
    "skill_description": { "type": "string", "required": true },
    "cycle_summary": { "type": "string", "required": false, "default": "Run one governed step, then seal or loop." }
  },
  "declares": {
    "files": [
      {
        "path": "plugins/{{plugin_name}}/skills/{{skill_name}}/SKILL.md",
        "body_ref": "skill_md"
      },
      {
        "path": "plugins/{{plugin_name}}/skills/{{skill_name}}/references/laws.md",
        "body_ref": "laws_reference"
      }
    ]
  },
  "requires_trail": true,
  "laws": ["EC-SYS-003", "EC-VERIFY-FIRST-001", "EC-004", "EC-009", "EC-PORTABLE-005"]
}
