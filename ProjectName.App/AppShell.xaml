<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProjectName.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:f="clr-namespace:ProjectName.App.Resources.Fonts"
    xmlns:pages="clr-namespace:ProjectName.App.Pages"
    xmlns:pmcro="clr-namespace:ProjectName.App.Pages.Pmcro"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource PmcroBg}"
    Shell.TabBarBackgroundColor="{StaticResource PmcroSurface}"
    Shell.TabBarForegroundColor="{StaticResource PmcroPrimary}"
    Shell.TabBarTitleColor="{StaticResource PmcroPrimary}"
    Shell.TabBarUnselectedColor="{StaticResource PmcroTextSecondary}"
    Title="pmcro">

    <Shell.Resources>
        <!-- Tab glyphs. Selected / unselected tinting comes from Shell.TabBar*Color. -->
        <FontImageSource x:Key="TabIconHome"
                         Glyph="{x:Static f:FluentUI.home_24_regular}"
                         FontFamily="{x:Static f:FluentUI.FontFamily}"
                         Color="{StaticResource PmcroTextSecondary}" />
        <FontImageSource x:Key="TabIconDiscover"
                         Glyph="{x:Static f:FluentUI.compass_northwest_24_regular}"
                         FontFamily="{x:Static f:FluentUI.FontFamily}"
                         Color="{StaticResource PmcroTextSecondary}" />
        <FontImageSource x:Key="TabIconTrails"
                         Glyph="{x:Static f:FluentUI.document_24_regular}"
                         FontFamily="{x:Static f:FluentUI.FontFamily}"
                         Color="{StaticResource PmcroTextSecondary}" />
        <FontImageSource x:Key="TabIconSettings"
                         Glyph="{x:Static f:FluentUI.options_24_regular}"
                         FontFamily="{x:Static f:FluentUI.FontFamily}"
                         Color="{StaticResource PmcroTextSecondary}" />
    </Shell.Resources>

    <!-- Four tabs, matching the PMCR-O design. Nothing is orphaned: Discover is the
         project browser, Settings is Manage Meta, and the Dashboard / PMCR-O runner
         stay reachable as registered routes (see MauiProgram). -->
    <TabBar>

        <ShellContent
            Title="Home"
            Icon="{StaticResource TabIconHome}"
            ContentTemplate="{DataTemplate pmcro:MarketplacePage}"
            Route="home" />

        <ShellContent
            Title="Discover"
            Icon="{StaticResource TabIconDiscover}"
            ContentTemplate="{DataTemplate pages:ProjectListPage}"
            Route="discover" />

        <ShellContent
            Title="Trails"
            Icon="{StaticResource TabIconTrails}"
            ContentTemplate="{DataTemplate pmcro:ActiveTrailPage}"
            Route="trail" />

        <ShellContent
            Title="Settings"
            Icon="{StaticResource TabIconSettings}"
            ContentTemplate="{DataTemplate pmcro:SettingsPage}"
            Route="settings" />

    </TabBar>

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
