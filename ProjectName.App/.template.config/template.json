{
  "$schema": "http://json.schemastore.org/template",
  "author": "Tooensure LLC",
  "classifications": ["MAUI", "Mobile", "Marketplace", "PMCRO", "Aspire"],
  "identity": "Tooensure.PMCRO.MauiMarketplace",
  "name": "PMCRO Governed .NET MAUI Marketplace App",
  "shortName": "pmcro-maui",
  "description": "Governed .NET MAUI marketplace application template for PMCRO autonomous app generation.",
  "sourceName": "ProjectName.App",
  "preferNameDirectory": true,
  "symbols": {
    "appName": {
      "type": "parameter",
      "datatype": "text",
      "description": "Application and root namespace name.",
      "defaultValue": "MarketplaceApp",
      "replaces": "ProjectName.App",
      "fileRename": "ProjectName.App"
    },
    "theme": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Application theme profile.",
      "choices": [
        { "choice": "default", "description": "PMCRO default theme" },
        { "choice": "light", "description": "Light theme" },
        { "choice": "dark", "description": "Dark theme" }
      ],
      "defaultValue": "default"
    },
    "featureSet": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Marketplace feature profile.",
      "choices": [
        { "choice": "core", "description": "Core marketplace" },
        { "choice": "commerce", "description": "Marketplace with commerce capabilities" },
        { "choice": "full", "description": "Full marketplace capability profile" }
      ],
      "defaultValue": "core"
    }
  }
}
