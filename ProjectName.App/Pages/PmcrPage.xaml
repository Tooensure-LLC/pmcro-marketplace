<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectName.App.Pages.PmcrPage"
             Style="{StaticResource PmcroDetailPage}"
             Title="PMCR-O">
    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,32" Spacing="16">

            <Label Text="Run a loop" Style="{StaticResource PmcroDisplay}" />
            <Label Text="Turn messy seed intent into a governed, evidence-backed cycle."
                   Style="{StaticResource PmcroBody}" />

            <Border Style="{StaticResource PmcroCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Seed intent" Style="{StaticResource PmcroFieldLabel}" />

                    <Border Style="{StaticResource PmcroField}"
                            BackgroundColor="{StaticResource PmcroSurface}">
                        <Editor x:Name="IntentEditor"
                                Placeholder="What do you want PMCR-O to accomplish?"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="110"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource PmcroTextPrimary}"
                                PlaceholderColor="{StaticResource PmcroTextMuted}" />
                    </Border>

                    <Button x:Name="RunButton" Text="Start PMCR-O cycle"
                            Style="{StaticResource PmcroButtonPrimary}"
                            Clicked="RunCycle" />

                    <Label Text="Opens a trail before writing - Log Before Act"
                           Style="{StaticResource PmcroCaption}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator x:Name="Busy" IsVisible="False" IsRunning="False"
                               Color="{StaticResource PmcroAccent}" />

            <Label x:Name="StatusLabel" Style="{StaticResource PmcroBodyStrong}" />

            <Label Text="The cycle runs on the orchestrator. Watch it on the Trails tab - this screen only seeds it."
                   Style="{StaticResource PmcroCaption}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
