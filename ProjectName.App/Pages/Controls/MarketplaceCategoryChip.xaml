<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ProjectName.App.Pages.Controls.MarketplaceCategoryChip"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">
    <Border Style="{StaticResource PmcroChip}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=Command}"
                                  CommandParameter="{Binding Source={x:Reference Root}, Path=Category}" />
        </Border.GestureRecognizers>
        <Label Text="{Binding Source={x:Reference Root}, Path=Category}"
               Style="{StaticResource PmcroChipLabel}" />
    </Border>
</ContentView>