<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AspireUseCliBundle>true</AspireUseCliBundle>
		<UserSecretsId>d4f84162-b4f4-4e2e-a0df-b5bef46bd101</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Aspire.Hosting.PostgreSQL" />
	  <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" />
	  <!-- MAUI orchestration: AddMauiProject + AddWindowsDevice/AddAndroidEmulator.
	       Aspire.Hosting.DevTunnels is referenced directly (not left transitive)
	       because AppHost.cs calls builder.AddDevTunnel(...) itself for the
	       Android emulator's HTTP path to OrchestratorApi, not just the
	       WithOtlpDevTunnel() convenience method Aspire.Hosting.Maui already
	       depends on. -->
	  <PackageReference Include="Aspire.Hosting.Maui" />
	  <PackageReference Include="Aspire.Hosting.DevTunnels" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Deliberately NOT a ProjectReference to ProjectName.App: AddMauiProject
	       takes the .csproj by path instead. A direct ProjectReference here
	       fails the AppHost build outright - AppHost targets net11.0 while
	       ProjectName.App multi-targets net11.0-android/-windows10.0.19041.0,
	       and MSBuild refuses to resolve a project reference across
	       incompatible TFMs (this is called out explicitly in the Aspire MAUI
	       integration docs, not just observed here). -->
	  <ProjectReference Include="..\api\ProjectName.CheckerGrpc\ProjectName.CheckerGrpc.csproj" />
	  <ProjectReference Include="..\api\ProjectName.MakerGrpc\ProjectName.MakerGrpc.csproj" />
	  <ProjectReference Include="..\api\ProjectName.ReflectorGrpc\ProjectName.ReflectorGrpc.csproj" />
	  <ProjectReference Include="..\api\ProjectName.OrchestratorApi\ProjectName.OrchestratorApi.csproj" />
	  <ProjectReference Include="..\api\ProjectName.OrchestratorGrpc\ProjectName.OrchestratorGrpc.csproj" />
	  <ProjectReference Include="..\api\ProjectName.PlannerGrpc\ProjectName.PlannerGrpc.csproj" />

	  <!-- ProjectName.Agents workers: trail-persisting MAF cycles, previously never
	       started by Aspire and never given the Ollama connection their
	       MafPhaseRunner constructor requires. -->
	  <ProjectReference Include="..\ProjectName.Agents\Planner\ProjectName.Agents.Planner.csproj" />
	  <ProjectReference Include="..\ProjectName.Agents\Maker\ProjectName.Agents.Maker.csproj" />
	  <ProjectReference Include="..\ProjectName.Agents\Checker\ProjectName.Agents.Checker.csproj" />
	  <ProjectReference Include="..\ProjectName.Agents\Reflector\ProjectName.Agents.Reflector.csproj" />
	</ItemGroup>

</Project>